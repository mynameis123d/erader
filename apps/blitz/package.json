{
  "name": "blitz-mode",
  "version": "0.1.0",
  "description": "Blitz Mode: swipe-to-approve AI-remixed short-form content, published via Buffer",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:preview": "vite build --mode demo",
    "check": "tsx scripts/check-keys.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@napi-rs/canvas": "^1.0.11",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.460.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  },
  "private": true,
  "type": "module"
}
