# Copy to .env (never commit .env) and fill in.

# --- Required for publishing -------------------------------------------------
# Buffer API key (https://publish.buffer.com -> Settings -> API). Server-side only.
BUFFER_API_KEY=
# Optional: pin a Buffer organization; otherwise the first one on the account is used.
BUFFER_ORGANIZATION_ID=
# Buffer downloads media by URL, so rendered slides/videos must be reachable from
# the internet. Point this at your deployed URL or a tunnel (cloudflared/ngrok)
# to this server, e.g. https://blitz.example.com
PUBLIC_BASE_URL=

# --- Recommended -------------------------------------------------------------
# Claude: analyzes your website and remixes viral formats for your product.
# Without it, Blitz uses built-in templates.
ANTHROPIC_API_KEY=
# Pexels (free, https://www.pexels.com/api/): background VIDEOS for "Wall of Text"
# posts and photos for slideshows. Strongly recommended.
PEXELS_API_KEY=
# Pixabay (free, https://pixabay.com/api/docs/): second source of background videos.
PIXABAY_API_KEY=
# Apify (https://console.apify.com/account/integrations): pulls currently trending
# TikToks to remix (real hooks + view counts). Pay-per-use.
APIFY_TOKEN=
# APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
# Without Pexels, slideshow photos come from Openverse (public domain, no key);
# set OPENVERSE=off to use painted scenes only.
# OPENVERSE=off

# --- Server ------------------------------------------------------------------
PORT=8787
