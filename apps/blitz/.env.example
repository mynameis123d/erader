# Copy to .env (never commit .env) and fill in.

# --- Required for publishing -------------------------------------------------
# Buffer API key (https://publish.buffer.com -> Settings -> API). Server-side only.
BUFFER_API_KEY=
# Optional: pin a Buffer organization; otherwise the first one on the account is used.
BUFFER_ORGANIZATION_ID=
# Buffer downloads media by URL, so rendered slides/videos must be reachable from
# the internet. Point this at your deployed URL or a tunnel (cloudflared/ngrok)
# to this server, e.g. https://blitz.example.com
PUBLIC_BASE_URL=

# --- Recommended -------------------------------------------------------------
# Claude: analyzes your website and remixes viral formats for your product.
# Without it, Blitz uses built-in templates.
ANTHROPIC_API_KEY=
# Pexels: free stock photos for slides (https://www.pexels.com/api/).
# Without it, slides use generated gradient backgrounds.
PEXELS_API_KEY=

# --- Server ------------------------------------------------------------------
PORT=8787
